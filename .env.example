# ---------------------------------------------------------------------------
# HOLDING — environment
# Copy to .env (never commit the real one). No secrets are committed.
# ---------------------------------------------------------------------------

# Which GenLayer the Reporter talks to.
#   demo            -> run the real contract logic locally (no chain, no consensus, no LLM)
#   bradbury        -> GenLayer Bradbury testnet (chain 4221)
#   asimov          -> GenLayer Asimov testnet
#   studionet       -> GenLayer Studio network
#   localnet        -> a local GenLayer node
#   mainnet         -> GenLayer mainnet
GENLAYER_NETWORK=demo

# RPC endpoint. Defaults to the documented public endpoint for the network above
# (Bradbury: https://rpc-bradbury.genlayer.com). Override for a private node.
# GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Chain id. Defaults per network (Bradbury 4221).
# GENLAYER_CHAIN_ID=4221

# Deployed addresses. REQUIRED whenever GENLAYER_NETWORK is not `demo` — the
# adapter refuses to start rather than serving demo data as if it were live.
HOLDING_REGISTRY_ADDRESS=
ADJUDICATOR_ADDRESS=

# Operator key for live writes (register sources, attest finality, cite).
# Never logged, never returned by the API, never committed.
GENLAYER_PRIVATE_KEY=

# Required for every /admin/* write. With no token set, admin routes return 503.
HOLDING_ADMIN_TOKEN=

# Seed the canonical three-case loop at startup in DEMO mode.
# Set to false for an empty registry (cold start).
HOLDING_DEMO_SEED=true

# Allow POST /demo/* on a non-mainnet live network. Refused unless true.
HOLDING_ALLOW_SIMULATION=false

# ---------------------------------------------------------------------------
# Wallet sign-in (optional — on by default)
# ---------------------------------------------------------------------------
# Session tokens are HMAC-signed with this. Unset: a key is derived from
# HOLDING_ADMIN_TOKEN, so rotating that token logs every wallet out.
HOLDING_SESSION_SECRET=

# Origin stamped into the message a wallet signs. Set it when the site sits
# behind a proxy, or the API is reached through a different host than the site.
# HOLDING_PUBLIC_ORIGIN=https://holding.example

# Wallets permitted to act as operators. Empty means nobody is an operator:
# any wallet may still propose a source contract, but only HOLDING_ADMIN_TOKEN
# can approve one, and approval is what writes to the registry.
HOLDING_OPERATOR_ADDRESSES=

# Where source-contract proposals are queued (git-ignored runtime state).
HOLDING_SOURCES_DB=data/source_contracts.json

# Reporter API
RATE_LIMIT_PER_MINUTE=120
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=

# Frontend (Next.js). Point this at the Reporter API. When unset, the site
# renders its bundled demo corpus and labels every figure DEMO.
HOLDING_API_URL=http://127.0.0.1:8000

# The browser talks to /api/reporter/* on its own origin and Next proxies it to
# HOLDING_API_URL (see next.config.mjs) — so there is no CORS to configure and
# no API address in the page. Set NEXT_PUBLIC_HOLDING_API_URL only if the API
# really is on another origin; that origin then needs CORS_ORIGINS to list the
# site. NEXT_PUBLIC_* is inlined at build time, so rebuild after changing it.
# NEXT_PUBLIC_HOLDING_API_URL=https://api.holding.example

# Indexer
INDEXER_DB=data/indexer.db
INDEXER_INTERVAL=30

# How long to wait for GenLayer consensus finality, in seconds.
# genlayer-py's built-in default is only 30s, which is not enough on Studio.
HOLDING_FINALITY_TIMEOUT=600
