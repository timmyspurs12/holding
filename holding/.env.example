# ---------------------------------------------------------------------------
# HOLDING — environment
# Copy to .env (never commit the real one). No secrets are committed.
# ---------------------------------------------------------------------------

# Which GenLayer the Reporter talks to.
#   demo            -> run the real contract logic locally (no chain, no consensus, no LLM)
#   bradbury        -> GenLayer Bradbury testnet (chain 4221)
#   asimov          -> GenLayer Asimov testnet
#   studionet       -> GenLayer Studio network
#   localnet        -> a local GenLayer node
#   mainnet         -> GenLayer mainnet
GENLAYER_NETWORK=demo

# RPC endpoint. Defaults to the documented public endpoint for the network above
# (Bradbury: https://rpc-bradbury.genlayer.com). Override for a private node.
# GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Chain id. Defaults per network (Bradbury 4221).
# GENLAYER_CHAIN_ID=4221

# Deployed addresses. REQUIRED whenever GENLAYER_NETWORK is not `demo` — the
# adapter refuses to start rather than serving demo data as if it were live.
HOLDING_REGISTRY_ADDRESS=
ADJUDICATOR_ADDRESS=

# Operator key for live writes (register sources, attest finality, cite).
# Never logged, never returned by the API, never committed.
GENLAYER_PRIVATE_KEY=

# Required for every /admin/* write. With no token set, admin routes return 503.
HOLDING_ADMIN_TOKEN=

# Seed the canonical three-case loop at startup in DEMO mode.
# Set to false for an empty registry (cold start).
HOLDING_DEMO_SEED=true

# Allow POST /demo/* on a non-mainnet live network. Refused unless true.
HOLDING_ALLOW_SIMULATION=false

# Reporter API
RATE_LIMIT_PER_MINUTE=120
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=

# Frontend (Next.js). Point this at the Reporter API. When unset, the site
# renders its bundled demo corpus and labels every figure DEMO.
HOLDING_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_HOLDING_API_URL=http://127.0.0.1:8000

# Indexer
INDEXER_DB=data/indexer.db
INDEXER_INTERVAL=30
